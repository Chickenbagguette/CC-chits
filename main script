-- AIMBOT (Silent & Sticky)
-- =============================================

local targetPlayer = nil
local stickyTarget = nil

local function GetClosestPlayer()
    local maxDist = Config.AimbotFOV or 120
    local target = nil
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local pos, on = Camera:WorldToViewportPoint(head.Position)
                if on then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < maxDist then
                        maxDist = dist
                        target = plr
                    end
                end
            end
        end
    end
    return target
end

local function IsKeyPressed(keyName)
    if keyName:find("MouseButton") then
        local btnNum = tonumber(keyName:match("(%d+)"))
        if btnNum == 1 then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
        if btnNum == 2 then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if btnNum == 3 then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3) end
    else
        local key = Enum.KeyCode[keyName]
        if key then return UserInputService:IsKeyDown(key) end
    end
    return false
end

local mouse = LocalPlayer:GetMouse()
if mouse then
    local mt = getrawmetatable and getrawmetatable(mouse) or nil
    if mt then
        local oldIdx = mt.__index
        mt.__index = function(self, key)
            if key == "Hit" and Config.AimbotEnabled then
                if IsKeyPressed(Config.AimbotKey) then
                    local target = nil
                    if Config.StickyAim and stickyTarget and stickyTarget.Character and stickyTarget.Character:FindFirstChild("Humanoid") and stickyTarget.Character.Humanoid.Health > 0 then
                        target = stickyTarget
                    else
                        target = GetClosestPlayer()
                        if target then
                            stickyTarget = target
                        end
                    end
                    if target and target.Character then
                        local head = target.Character:FindFirstChild("Head")
                        if head then
                            targetPlayer = target
                            local origin = Camera.CFrame.Position
                            local dir = (head.Position - origin).Unit
                            if Config.SilentAim then
                                return CFrame.lookAt(origin, origin + dir * 1000)
                            else
                                local newCFrame = CFrame.lookAt(origin, head.Position)
                                local smooth = Config.AimbotSmoothness or 0.3
                                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 1 - smooth)
                            end
                        end
                    end
                else
                    targetPlayer = nil
                    if not Config.StickyAim then
                        stickyTarget = nil
                    end
                end
            end
            return oldIdx and oldIdx(self, key) or rawget(self, key)
        end
    end
end

