local function ShowInventory(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    
    local backpack = targetPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then
        print("No backpack found for " .. targetPlayer.Name)
        return
    end
    
    print("--- Inventory of " .. targetPlayer.Name .. " ---")
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            print("  > " .. item.Name)
            local imageId = item.TextureId or item.Icon
            if imageId then
                print("    Image: " .. imageId)
            end
        end
    end
    print("---------------------------------")
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if Config.InventoryCheck and input.KeyCode == Enum.KeyCode[Config.InventoryKey] then
        local target = GetClosestPlayer()
        if target then
            ShowInventory(target)
        else
            print("No player found within FOV to check inventory.")
        end
    end
end)

