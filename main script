local function GetBones(character)
    local bones = {}
    local joints = {
        "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot", "LeftShoulder", "RightShoulder"
    }
    for _, name in ipairs(joints) do
        local part = character:FindFirstChild(name)
        if part then table.insert(bones, part) end
    end
    return bones
end

local function GetPlayerAmmo(player)
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    local weaponName = tool.Name
    local ammoData = AMMO_TYPES[weaponName]
    if not ammoData then
        for name, data in pairs(AMMO_TYPES) do
            if weaponName:find(name) then
                ammoData = data
                break
            end
        end
    end
    if ammoData then
        return ammoData.Ammo
    end
    return nil
end

local function UpdatePlayerESP()
    if not Config.ESPEnabled then
        for _, data in pairs(espObjects) do
            data.box.Visible = false
            data.nameTag.Visible = false
            data.ammoTag.Visible = false
            data.distanceTag.Visible = false
            data.healthText.Visible = false
            data.headDot.Visible = false
            data.headCircle.Visible = false
            data.healthBar.Visible = false
            for _, line in ipairs(data.skeletonLines) do line.Visible = false end
        end
        return
    end

    for player, data in pairs(espObjects) do
        if not player or not player.Character or not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 then
            data.box.Visible = false
            data.nameTag.Visible = false
            data.ammoTag.Visible = false
            data.distanceTag.Visible = false
            data.healthText.Visible = false
            data.headDot.Visible = false
            data.headCircle.Visible = false
            data.healthBar.Visible = false
            for _, line in ipairs(data.skeletonLines) do line.Visible = false end
            continue
        end

        local root = player.Character:FindFirstChild("HumanoidRootPart")
        local head = player.Character:FindFirstChild("Head")
        local hum = player.Character:FindFirstChild("Humanoid")
        if not root or not head or not hum then continue end

        local distance = (Camera.CFrame.Position - root.Position).Magnitude
        local rp, ron = Camera:WorldToViewportPoint(root.Position)
        local hp, hon = Camera:WorldToViewportPoint(head.Position)

        if ron and hon then
            local height = (rp.Y - hp.Y) * 1.5
            local width = height * 0.5
            local left = rp.X - width / 2
            local top = hp.Y - height * 0.2

            if Config.ESPBox then
                data.box.Size = Vector2.new(width, height)
                data.box.Position = Vector2.new(left, top)
                data.box.Color = COLORS.Box
                data.box.Visible = true
            else
                data.box.Visible = false
            end

            if Config.ESPName then
                data.nameTag.Position = Vector2.new(rp.X, top - 35)
                data.nameTag.Text = player.Name
                data.nameTag.Color = COLORS.Name
                data.nameTag.Visible = true
            else
                data.nameTag.Visible = false
            end

            if Config.ESPAmmo then
                local ammo = GetPlayerAmmo(player)
                if ammo then
                    data.ammoTag.Position = Vector2.new(rp.X, top - 20)
                    data.ammoTag.Text = "🔫 " .. ammo
                    data.ammoTag.Color = COLORS.Ammo
                    data.ammoTag.Visible = true
                else
                    data.ammoTag.Visible = false
                end
            else
                data.ammoTag.Visible = false
            end

            if Config.ESPDistance then
                data.distanceTag.Position = Vector2.new(rp.X, top + height + 20)
                data.distanceTag.Text = math.floor(distance) .. " studs"
                data.distanceTag.Color = COLORS.Distance
                data.distanceTag.Visible = true
            else
                data.distanceTag.Visible = false
            end

            if Config.ESPHealthText then
                data.healthText.Position = Vector2.new(rp.X, top + height + 35)
                data.healthText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth) .. " HP"
                data.healthText.Color = COLORS.HealthText
                data.healthText.Visible = true
            else
                data.healthText.Visible = false
            end

            if Config.ESPHeadDot then
                data.headDot.Position = Vector2.new(hp.X, hp.Y)
                data.headDot.Color = COLORS.Head
                data.headDot.Visible = true
            else
                data.headDot.Visible = false
            end

            if Config.ESPHeadCircle then
                data.headCircle.Position = Vector2.new(hp.X, hp.Y)
                data.headCircle.Color = COLORS.HeadCircle
                data.headCircle.Visible = true
            else
                data.headCircle.Visible = false
            end

            if Config.ESPHealthBar then
                local pct = hum.Health / hum.MaxHealth
                local bx = left + width + 5
                local by = top
                local bh = height * pct
                data.healthBar.From = Vector2.new(bx, by + height - bh)
                data.healthBar.To = Vector2.new(bx, by + height)
                data.healthBar.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                data.healthBar.Visible = true
            else
                data.healthBar.Visible = false
            end

            if Config.ESPSkeleton then
                local bones = GetBones(player.Character)
                local bonePositions = {}
                for _, bone in ipairs(bones) do
                    local pos, onScreen = Camera:WorldToViewportPoint(bone.Position)
                    if onScreen then table.insert(bonePositions, pos) end
                end
                local lineIndex = 1
                for i = 1, #bonePositions - 1 do
                    for j = i + 1, #bonePositions do
                        if lineIndex <= #data.skeletonLines then
                            local d = (Vector2.new(bonePositions[i].X, bonePositions[i].Y) - Vector2.new(bonePositions[j].X, bonePositions[j].Y)).Magnitude
                            if d < 250 then
                                data.skeletonLines[lineIndex].From = Vector2.new(bonePositions[i].X, bonePositions[i].Y)
                                data.skeletonLines[lineIndex].To = Vector2.new(bonePositions[j].X, bonePositions[j].Y)
                                data.skeletonLines[lineIndex].Color = COLORS.Skeleton
                                data.skeletonLines[lineIndex].Visible = true
                                lineIndex = lineIndex + 1
                            end
                        end
                    end
                end
                for i = lineIndex, #data.skeletonLines do
                    data.skeletonLines[i].Visible = false
                end
            else
                for _, line in ipairs(data.skeletonLines) do line.Visible = false end
            end
        else
            data.box.Visible = false
            data.nameTag.Visible = false
            data.ammoTag.Visible = false
            data.distanceTag.Visible = false
            data.healthText.Visible = false
            data.headDot.Visible = false
            data.headCircle.Visible = false
            data.healthBar.Visible = false
            for _, line in ipairs(data.skeletonLines) do line.Visible = false end
        end
    end
end

