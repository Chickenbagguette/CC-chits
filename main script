local function UpdateTargetDisplay()
    if targetPlayer and targetPlayer.Character then
        local head = targetPlayer.Character:FindFirstChild("Head")
        if head then
            local pos, on = Camera:WorldToViewportPoint(head.Position)
            if on then
                targetLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                targetLine.To = Vector2.new(pos.X, pos.Y)
                targetLine.Visible = true
                targetLabel.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y - 30)
                targetLabel.Text = "🎯 " .. targetPlayer.Name
                targetLabel.Color = COLORS.TargetLine
                targetLabel.Visible = true
                return
            end
        end
    end
    targetLine.Visible = false
    targetLabel.Visible = false
end

