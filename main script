Players.PlayerRemoved:Connect(function(plr)
    if espObjects[plr] then
        espObjects[plr].box:Remove()
        espObjects[plr].nameTag:Remove()
        espObjects[plr].ammoTag:Remove()
        espObjects[plr].distanceTag:Remove()
        espObjects[plr].healthText:Remove()
        espObjects[plr].headDot:Remove()
        espObjects[plr].headCircle:Remove()
        espObjects[plr].healthBar:Remove()
        for _, line in ipairs(espObjects[plr].skeletonLines) do line:Remove() end
        espObjects[plr] = nil
    end
    if targetPlayer == plr then targetPlayer = nil end
    if stickyTarget == plr then stickyTarget = nil end
end)

