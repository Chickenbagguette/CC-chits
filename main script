        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 10)
        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            local current = Config[configKey]
            local nextVal = values[1]
            for i, v in ipairs(values) do
                if v > current then
                    nextVal = v
                    break
                end
            end
            if nextVal == current then
                nextVal = values[1]
            end
            Config[configKey] = nextVal
            btn.Text = displayFormat(nextVal)
            text.Text = label .. ": " .. displayFormat(nextVal)
        end)

        parent.CanvasSize = UDim2.new(0, 0, 0, yPos + 34)
        return btn
    end

